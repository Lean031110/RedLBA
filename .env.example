# ---------------------------------------------------------------------------
# RedLBA · configuración
# Copia este fichero a .env y ajusta los valores. Nunca lo subas al repositorio.
# ---------------------------------------------------------------------------

# --- Núcleo ----------------------------------------------------------------
REDLBA_DOMAIN=redlba.local
REDLBA_BASE_URL=http://localhost:8080
PORT=8080
HOST=0.0.0.0
# Genera la tuya con: openssl rand -hex 32
SECRET_KEY=dev-secret-key-change-me-please-0123456789abcdef
# Dominio de la cookie de sesión (SSO entre subdominios). Vacío = solo el host actual.
# COOKIE_DOMAIN=.redlba.tld
SESSION_TTL_HOURS=12
TRUST_PROXY=true
LOG_LEVEL=info
DATABASE_PATH=./data/redlba.db

# --- Autenticación ---------------------------------------------------------
# ldap | local | hybrid (LDAP + cuenta local de emergencia)
AUTH_MODE=hybrid
ADMIN_USER=admin
ADMIN_PASSWORD=cambiame-ahora

# --- LDAP ------------------------------------------------------------------
LDAP_URL=ldap://localhost:389
LDAP_BIND_DN=cn=admin,dc=redlba,dc=local
LDAP_BIND_PASSWORD=admin
LDAP_BASE_DN=dc=redlba,dc=local
LDAP_USERS_OU=ou=people
LDAP_GROUPS_OU=ou=groups
LDAP_USER_ATTR=uid
LDAP_STARTTLS=false
LDAP_TLS_INSECURE=false
LDAP_UPN_SUFFIX=

# --- Correo ----------------------------------------------------------------
# ldap | mailcow | none
MAIL_DRIVER=ldap
MAIL_DOMAIN=redlba.local
MAIL_DEFAULT_QUOTA_MB=5120
MAILCOW_URL=
MAILCOW_API_KEY=
MAIL_ALIASES_ENABLED=true

# --- Operación -------------------------------------------------------------
AUDIT_RETENTION_DAYS=90
# Dominios extra permitidos para módulos (separados por coma)
ALLOWED_MODULE_DOMAINS=
