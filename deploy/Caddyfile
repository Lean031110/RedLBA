{
	email {$ACME_EMAIL}
}

# RedLBA · los cuatro subdominios servidos por la misma app.
# El Host decide qué ve: portal, panel, buscador o webmail.
(redlba) {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
		X-Frame-Options "SAMEORIGIN"
	}
	reverse_proxy redlba:8080
}

# --- Portal ----------------------------------------------------------------
portal.{$REDLBA_DOMAIN} {
	import redlba
}

{$REDLBA_DOMAIN} {
	redir https://portal.{$REDLBA_DOMAIN}{uri} 302
}

# --- Administración --------------------------------------------------------
admin.{$REDLBA_DOMAIN} {
	import redlba
}

# --- Buscador --------------------------------------------------------------
buscar.{$REDLBA_DOMAIN} {
	import redlba
}

# --- Webmail ---------------------------------------------------------------
correo.{$REDLBA_DOMAIN} {
	import redlba
}

