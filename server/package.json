{
  "name": "@redlba/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "bootstrap": "tsx src/scripts/bootstrap.ts",
    "ldap:sync": "tsx src/scripts/ldap-sync.ts",
    "ldap:check": "tsx src/scripts/ldap-check.ts",
    "backup": "tsx src/scripts/backup.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/formbody": "^9.0.1",
    "@fastify/static": "^8.1.1",
    "fastify": "^5.2.1",
    "imapflow": "^2.9.1",
    "jose": "^6.2.13",
    "ldapts": "^8.0.9",
    "mailparser": "^3.12.4",
    "nodemailer": "^10.2.1",
    "sanitize-html": "^2.18.1"
  },
  "devDependencies": {
    "@types/mailparser": "^3.9.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/sanitize-html": "^2.16.2",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
